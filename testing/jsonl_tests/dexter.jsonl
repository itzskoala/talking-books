# {"question": "Who narrates Darkly Dreaming Dexter?", "keywords": ["Dexter"], "reference_answer": "Dexter Morgan narrates the novel in the first person.", "source_chapter": 1, "category": "direct_fact"}
{"question": "What is Dexter's profession?", "keywords": ["Dexter", "blood spatter", "Miami police"], "reference_answer": "Dexter works as a blood-spatter analyst for the Miami-Dade police.", "source_chapter": 3, "category": "direct_fact"}
{"question": "Who is Dexter's foster father?", "keywords": ["Harry", "foster father", "Dexter"], "reference_answer": "Harry is Dexter's foster father and the person who taught him how to manage his violent impulses through a set of rules.", "source_chapter": [16, 17, 27], "category": "direct_fact"}
{"question": "What is the name of Dexter's sister?", "keywords": ["Deborah", "sister", "Dexter"], "reference_answer": "Deborah Morgan is Dexter's sister.", "source_chapter": 1, "category": "direct_fact"}
